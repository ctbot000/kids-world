{
  "name": "kids-world",
  "version": "1.0.0",
  "description": "A cozy 3D block-building island game for kids, to play together in the browser.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "vendor": "node scripts/vendor.mjs",
    "icon": "node scripts/icon.mjs",
    "keeper-setup": "node scripts/keeper-setup.mjs",
    "test": "node --test --test-timeout=180000 --test-force-exit",
    "check": "node scripts/check.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ctbot000/kids-world.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "idb-keyval": "^6.3.0",
    "peer": "^1.0.2",
    "peerjs": "^1.5.5",
    "puppeteer-core": "^25.12.0",
    "terser": "^5.51.2",
    "three": "^0.186.1"
  },
  "dependencies": {
    "geoip-lite": "^2.0.3",
    "node-datachannel": "^0.33.4",
    "send": "^1.2.1",
    "serve-static": "^2.2.1",
    "ws": "^8.22.0"
  }
}
